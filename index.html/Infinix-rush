let score=0, lives=3, playing=false, playerX=45;
let best = localStorage.getItem('best') || 0;
document.getElementById('score').innerText='Score: 0 | Lives: 3 | Best: '+best;
let game=document.getElementById('game');
let player=document.getElementById('player');
let scores = JSON.parse(localStorage.getItem('scores')||'[]');
updateBoard();
function beep(f){ try{ let a=new (window.AudioContext||window.webkitAudioContext)(); let o=a.createOscillator(); o.frequency.value=f; o.connect(a.destination); o.start(); o.stop(a.currentTime+0.1);}catch(e){} }
game.addEventListener('touchmove', e=>{ move(e.touches[0].clientX) });
game.addEventListener('mousemove', e=>{ move(e.clientX) });
function move(x){ let r=game.getBoundingClientRect(); playerX=((x-r.left)/r.width*100); player.style.left=playerX+'%'; }
function startGame(){ score=0; lives=3; playing=true; document.getElementById('score').innerText='Score: 0 | Lives: 3 | Best: '+best; spawn(); }
function updateBoard(){ if(scores.length==0) return; scores.sort((a,b)=>b-a); document.getElementById('board').innerHTML = scores.slice(0,5).map((s,i)=> (i+1)+'. '+s+' pts').join('<br>'); }
function spawn(){
  if(!playing) return;
  let item=document.createElement('div');
  item.className='item';
  let isBomb=Math.random()<0.25;
  item.innerText=isBomb?'💣':'📱';
  item.style.left=Math.random()*85+'%';
  item.style.top='0px';
  game.appendChild(item);
  let y=0;
  let fall=setInterval(()=>{
    y+=4; item.style.top=y+'px';
    let itemX=parseFloat(item.style.left);
    if(y>game.clientHeight-80 && Math.abs(itemX-playerX)<8){
      if(isBomb){ lives--; beep(150); alert('Bomb! Lives left: '+lives); if(lives<=0){ playing=false; if(score>best){best=score; localStorage.setItem('best',best);} scores.push(score); localStorage.setItem('scores',JSON.stringify(scores)); updateBoard(); alert('Game Over! Score: '+score+' | Best: '+best); } }
      else{ score+=10; beep(600); document.getElementById('score').innerText='Score: '+score+' | Lives: '+lives+' | Best: '+best; }
      clearInterval(fall); item.remove();
    }
    if(y>game.clientHeight){ clearInterval(fall); item.remove(); }
  },30);
  setTimeout(spawn, 800);
}
</script>
